<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDeliveryOrder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#14241C"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="#2A4838"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Checkbox, Order Number, Route Stop Badge, and Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbSelectOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#00E676"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvDeliveryOrderNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:textColor="#00E676"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Pedido #00124" />

            <!-- Route Stop Badge (🥇 Parada #1) -->
            <TextView
                android:id="@+id/tvDeliveryRouteStopBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="#2E4A1E"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#AEEA00"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Parada #1 🥇"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvDeliveryStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_delivery_tab_selected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="📦 LISTO" />
        </LinearLayout>

        <!-- Time, Products & Distance/Shipping Fee Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDeliveryOrderTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#8AA394"
                android:textSize="12sp"
                tools:text="🕒 Hace 15 min • 3 productos" />

            <TextView
                android:id="@+id/tvDeliveryDistanceFeeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1B3326"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="📏 2.3 km • Envío S/ 4.00" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#22372B" />

        <!-- Customer Name and Phone Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 "
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDeliveryCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Carlos Mendoza" />

                <TextView
                    android:id="@+id/tvDeliveryCustomerPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#A0B3A8"
                    android:textSize="13sp"
                    tools:text="📞 987 654 321" />
            </LinearLayout>
        </LinearLayout>

        <!-- Modern High-Comfort Quick Contact Pill Buttons Bar -->
        <LinearLayout
            android:id="@+id/layoutDeliveryQuickContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Call Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeliveryCall"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1D3E2B"
                android:text="Llamar"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_admin_call"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="#00E676"
                app:strokeColor="#2A593E"
                app:strokeWidth="1dp" />

            <!-- WhatsApp Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeliveryWhatsApp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#143D23"
                android:text="WhatsApp"
                android:textColor="#25D366"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_admin_whatsapp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="#25D366"
                app:strokeColor="#20693B"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Destination Address and Reference Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#0E1A14"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 "
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvDeliveryAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Av. Mariscal Benavides 450, San Vicente" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeliveryReference"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:textColor="#A0B3A8"
                android:textSize="12sp"
                tools:text="Ref: Frente al parque principal, casa azul" />

            <TextView
                android:id="@+id/tvDeliveryKitchenNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:textColor="#FFD54F"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="📝 Nota: Tocar timbre 2 veces" />
        </LinearLayout>

        <!-- Items Summary List Preview -->
        <TextView
            android:id="@+id/tvDeliveryItemsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#BACEC2"
            android:textSize="13sp"
            tools:text="🍗 2x Combo Alitas Broaster + 1x Gaseosa Inka Cola 500ml" />

        <!-- Payment Method and Total Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1B3326"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDeliveryPaymentMethodIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💵"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDeliveryPaymentMethodTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Pago en Efectivo" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDeliveryPaymentDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    tools:text="Paga con: S/ 50.00 • Vuelto: S/ 15.00" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeliveryTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#00E676"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="S/ 35.00" />
        </LinearLayout>

        <!-- Actions Row: Navigation GPS & CTA Main Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeliveryNavigateGps"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#1D3E2B"
                android:text="GPS"
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_navigation_gps"
                app:iconSize="18dp"
                app:iconTint="#00E676" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeliveryMainAction"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#00C853"
                android:text="Tomar Pedido 🛵"
                android:textColor="#0A1810"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
