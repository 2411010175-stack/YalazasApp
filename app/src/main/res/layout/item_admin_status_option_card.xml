<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardStatusOption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#18221D"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#2C3B33"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvOptionIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_admin_gear_btn"
            android:gravity="center"
            android:textSize="18sp"
            tools:text="👨‍🍳" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOptionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Avanzar a: EN COCINA"
                tools:textColor="#29B6F6" />

            <TextView
                android:id="@+id/tvOptionDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#9EADA4"
                android:textSize="11.5sp"
                tools:text="El equipo de cocina iniciará la preparación de los platos." />
        </LinearLayout>

        <RadioButton
            android:id="@+id/rbOptionSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
