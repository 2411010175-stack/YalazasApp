<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yalaza_bg"
    android:orientation="vertical">

    <!-- La misma cabecera con logo y brillo que utiliza administración. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="44dp"
            android:contentDescription="Yalazas Restaurante"
            android:scaleType="fitStart"
            android:src="@drawable/yalaza_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalirCocina"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="Cerrar sesión de cocina"
            android:text="Salir"
            android:textColor="@color/yalaza_pink"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/bg_header_glow" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/yalaza_surface"
        app:cardCornerRadius="18dp"
        app:strokeColor="@color/yalaza_pink"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_greeting"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COCINA · PEDIDOS EN VIVO"
                android:textColor="@color/yalaza_pink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Comandas del restaurante"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSaludoCocina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pedidos que necesitan preparación"
                android:textColor="@color/yalaza_yellow"
                android:textSize="14sp"
                tools:text="Hola, Alex · Comandas en tiempo real" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dos opciones grandes; el color activo se actualiza desde el fragmento. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivosCocina"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Por preparar"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/yalaza_pink"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListosCocina"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Listos"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/yalaza_pink"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progresoCocina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:indeterminateTint="@color/yalaza_lime" />

    <TextView
        android:id="@+id/tvVacioCocina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_admin_kpi_card"
        android:gravity="center"
        android:minHeight="112dp"
        android:padding="20dp"
        android:text="No hay pedidos por preparar 🍗"
        android:textColor="@color/yalaza_text_secondary"
        android:textSize="17sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaCocina"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        tools:listitem="@layout/item_comanda_cocina" />
</LinearLayout>
