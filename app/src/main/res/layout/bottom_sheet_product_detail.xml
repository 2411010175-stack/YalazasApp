<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_admin_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Drag Handle Indicator -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_admin_drag_handle" />

        <!-- Large Product Hero Image Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            app:cardBackgroundColor="#131C17"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#24332B"
            app:strokeWidth="1.5dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDetailHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@drawable/img_alitas_combo" />

                <!-- Category Badge Top-Left -->
                <TextView
                    android:id="@+id/tvDetailCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_admin_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/yalaza_lime"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="🍗 ALITAS" />

                <!-- Offer Badge Top-Right -->
                <TextView
                    android:id="@+id/tvDetailOfferBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_offer_badge"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="🔥 25% OFF"
                    tools:visibility="visible" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Product Title & Tagline -->
        <TextView
            android:id="@+id/tvDetailProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="ACEVICHADAS" />

        <TextView
            android:id="@+id/tvDetailProductTagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/yalaza_lime"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="¡LA FIRMA DE LA CASA!" />

        <!-- Price & Offers Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDetailPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/yalaza_lime"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="S/ 16.00" />

            <TextView
                android:id="@+id/tvDetailOriginalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#9EADA4"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="S/ 25.00"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvDetailDiscountPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_offer_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Ahorras S/ 9.00"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#24332B" />

        <!-- Description Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#131C17"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#24332B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 Descripción del plato"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#D0DDD5"
                    android:textSize="13.5sp"
                    tools:text="Nuestras alitas bañadas en la emblemática salsa acevichada cremosa con toque de ají limo, culantro fresco picado y choclo crocante. Una verdadera explosión marina y crujiente." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sauces / Combo Info Banner (Visible only for combos / items that allow sauces) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDetailSaucesInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#15271D"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#2C523B"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🍗 Salsas incluidas en este plato"
                        android:textColor="@color/yalaza_lime"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailSauceAllowance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_admin_item_qty"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/yalaza_lime"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        tools:text="Hasta 2 salsas" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Al hacer clic en el botón inferior podrás elegir tus salsas artesanales preferidas y dejar notas a cocina."
                    android:textColor="#A5B8AC"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Preparation Notes / Comments Input (for non-combo items) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDetailNotes"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="📝 Observaciones para cocina (Opcional)"
            android:textColorHint="#9EADA4"
            app:boxBackgroundColor="#131C17"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/admin_border_gold"
            app:hintTextColor="@color/admin_border_gold">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDetailNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quantity & Add to Cart / Choose Sauces Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Stepper Quantity (Visible only for direct add items) -->
            <LinearLayout
                android:id="@+id/layoutDetailQtyStepper"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="@drawable/bg_admin_form_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <ImageButton
                    android:id="@+id/btnDetailQtyMinus"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvDetailQuantity"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnDetailQtyPlus"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailAction"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/yalaza_lime"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Agregar • S/ 16.00"
                android:textColor="#0B1A10"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:cornerRadius="25dp"
                app:icon="@drawable/ic_shopping_bag_cart"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="#0B1A10" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
