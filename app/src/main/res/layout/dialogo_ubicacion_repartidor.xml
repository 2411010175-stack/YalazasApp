<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/yalaza_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛵 Tu pedido en camino"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMapDriverName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/yalaza_pink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMapDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Esperando la ubicación del repartidor"
        android:textColor="@color/admin_border_gold"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMapUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="El mapa se actualizará cuando llegue la primera señal GPS."
        android:textColor="#9EADA4"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="12dp"
        android:background="#14201A">

        <org.osmdroid.views.MapView
            android:id="@+id/mapTrackingDriver"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCenterTrackingMap"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:backgroundTint="@color/yalaza_pink"
            android:text="Centrar"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:cornerRadius="10dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvMapRouteStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="La ruta aparecerá cuando llegue el GPS del repartidor."
        android:textColor="@color/yalaza_pink"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvMapDestination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="La distancia indicada es en línea recta. La línea rosa muestra una ruta posible, no el recorrido confirmado del repartidor."
        android:textColor="#9EADA4"
        android:textSize="11sp" />
</LinearLayout>
