<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A140F">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshDelivery"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="120dp">

                <!-- Top Header Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#102018"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Avatar / Scooter Icon -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_delivery_card">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🛵"
                                android:textSize="24sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDeliveryDriverGreeting"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="¡Hola Alex! 👋" />

                            <TextView
                                android:id="@+id/tvDeliveryDriverStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="#00E676"
                                android:textSize="13sp"
                                tools:text="🟢 En Turno • Repartidor Oficial" />
                        </LinearLayout>

                        <!-- Quick Refresh Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDeliveryRefresh"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:backgroundTint="#1B3828"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_admin_daily_sales"
                            app:iconSize="20dp"
                            app:iconTint="#00E676" />
                    </LinearLayout>

                    <!-- Sub Header Quick Metric Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- Card Disponibles -->
                        <LinearLayout
                            android:id="@+id/cardMetricAvailable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_delivery_card"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Por Recoger"
                                android:textColor="#8AA394"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvMetricAvailableCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#00E676"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="3" />
                        </LinearLayout>

                        <!-- Card En Ruta -->
                        <LinearLayout
                            android:id="@+id/cardMetricInRoute"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_delivery_card"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mis Entregas"
                                android:textColor="#8AA394"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvMetricInRouteCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#FFD54F"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="1" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Custom Tabs Filter Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:background="#12221A"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tabDeliveryAvailable"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_delivery_tab_selected"
                        android:gravity="center"
                        android:text="Por Recoger 📦"
                        android:textColor="#00E676"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabDeliveryInRoute"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_delivery_tab_unselected"
                        android:gravity="center"
                        android:text="En Ruta (Mis Entregas) 🛵"
                        android:textColor="#8AA394"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Loading Indicator -->
                <ProgressBar
                    android:id="@+id/progressDelivery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:indeterminateTint="#00E676"
                    android:visibility="gone" />

                <!-- Empty State View -->
                <LinearLayout
                    android:id="@+id/layoutDeliveryEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="32dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmptyIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛵💨"
                        android:textSize="54sp" />

                    <TextView
                        android:id="@+id/tvEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="¡Sin pedidos pendientes!"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmptySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Actualmente no hay pedidos listos en cocina. Te notificaremos cuando ingresen nuevos pedidos."
                        android:textColor="#8AA394"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Orders RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDeliveryOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_delivery_order" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Batch Selection & Smart Route Optimizer Action Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBatchAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="80dp"
        android:visibility="gone"
        app:cardBackgroundColor="#F2102018"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:strokeColor="#00E676"
        app:strokeWidth="1.5dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBatchSelectedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="2 pedidos seleccionados" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Optimización de ruta inteligente ⚡"
                    android:textColor="#8AA394"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatchOptimizeAndTake"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="#00C853"
                android:text="Tomar y Optimizar 🚀"
                android:textColor="#0A1810"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
