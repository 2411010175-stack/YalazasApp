<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_admin_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Drag Handle Indicator -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_admin_drag_handle" />

        <!-- Header: Order Number + Customer + Current Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatusSheetOrderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Venta N° 00004" />

                <TextView
                    android:id="@+id/tvStatusSheetCustomerInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#9EADA4"
                    android:textSize="12.5sp"
                    tools:text="👤 Alex Yalaza • Total: S/ 45.00" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusSheetCurrentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_admin_pill"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="#FFD54F"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="● PENDIENTE" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="#24332B" />

        <!-- Mini Stepper visual del flujo -->
        <LinearLayout
            android:id="@+id/layoutSheetStepper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_admin_detail_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="PROGRESO DEL PEDIDO"
                android:textColor="#9EADA4"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Step 1: Pendiente -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniStep1Icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_admin_gear_btn"
                        android:gravity="center"
                        android:text="🟡"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMiniStep1Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pendiente"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/lineMiniStep1to2"
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:background="#2C3B33" />

                <!-- Step 2: Cocina -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniStep2Icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_admin_gear_btn"
                        android:gravity="center"
                        android:text="👨‍🍳"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMiniStep2Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Cocina"
                        android:textColor="#9EADA4"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:id="@+id/lineMiniStep2to3"
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:background="#2C3B33" />

                <!-- Step 3: Camino -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniStep3Icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_admin_gear_btn"
                        android:gravity="center"
                        android:text="🛵"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMiniStep3Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Camino"
                        android:textColor="#9EADA4"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:id="@+id/lineMiniStep3to4"
                    android:layout_width="16dp"
                    android:layout_height="2dp"
                    android:background="#2C3B33" />

                <!-- Step 4: Entregado -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniStep4Icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_admin_gear_btn"
                        android:gravity="center"
                        android:text="✅"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMiniStep4Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Entregado"
                        android:textColor="#9EADA4"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Section Title: Acciones / Transiciones -->
        <TextView
            android:id="@+id/tvStatusSheetSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ ACTUALIZAR A UN NUEVO ESTADO"
            android:textColor="@color/yalaza_lime"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusSheetSectionDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="Selecciona el siguiente estado para coordinar con cocina y delivery:"
            android:textColor="#9EADA4"
            android:textSize="12sp" />

        <!-- Banner para órdenes finalizadas o canceladas -->
        <LinearLayout
            android:id="@+id/layoutSheetFinishedBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_admin_detail_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSheetFinishedIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvSheetFinishedMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Este pedido ya se encuentra completado y no admite más transiciones."
                android:textColor="@color/white"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Contenedor dinámico de Tarjetas de Estado -->
        <LinearLayout
            android:id="@+id/containerStatusCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Botones de Acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusSheetCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cancelar"
                android:textColor="#9EADA4"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="#38483F"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusSheetConfirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.6"
                android:backgroundTint="@color/yalaza_lime"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Confirmar Cambio"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
