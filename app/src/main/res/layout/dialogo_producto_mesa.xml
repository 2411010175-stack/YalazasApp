<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yalaza_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <TextView android:id="@+id/tvTituloProductoMesa" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/white"
            android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvPrecioUnitarioMesa" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textColor="@color/yalaza_lime_dark" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Cantidad"
            android:textColor="@color/cocina_text_secondary" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton
                android:id="@+id/btnMenosProductoMesa"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_boton_cantidad_mesa"
                android:contentDescription="Reducir cantidad"
                android:padding="13dp"
                android:src="@drawable/ic_remove"
                android:tint="@color/white" />
            <TextView android:id="@+id/tvCantidadProductoMesa" android:layout_width="60dp"
                android:layout_height="wrap_content" android:gravity="center" android:text="1"
                android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
            <ImageButton
                android:id="@+id/btnMasProductoMesa"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_boton_cantidad_mesa"
                android:contentDescription="Aumentar cantidad"
                android:padding="13dp"
                android:src="@drawable/ic_add"
                android:tint="@color/white" />
        </LinearLayout>
        <TextView android:id="@+id/tvAyudaSalsasMesa" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textColor="@color/cocina_text_secondary" android:textSize="13sp"
            android:visibility="gone" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoSalsasMesa" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            app:singleSelection="false" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="Nota para este plato (opcional)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNotaProductoMesa" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine"
                android:maxLength="200" android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvTotalProductoMesa" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:gravity="end" android:textColor="@color/yalaza_lime_dark"
            android:textSize="19sp" android:textStyle="bold" />
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/yalaza_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarProductoMesa"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarProductoConfiguradoMesa"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Agregar plato"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/yalaza_pink"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
