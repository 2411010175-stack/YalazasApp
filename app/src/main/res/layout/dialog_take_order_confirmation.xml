<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="#122019"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:strokeColor="#2A4838"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:id="@+id/layoutTakeOrderContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Animated Delivery Icon Circle -->
        <FrameLayout
            android:id="@+id/flTakeOrderIconContainer"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_take_order_icon_circle">

            <ImageView
                android:id="@+id/ivTakeOrderIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="Tomar Pedido"
                android:src="@drawable/ic_delivery_scooter"
                app:tint="#00E676" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTakeOrderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🛵 ¿Tomar este Pedido?"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtitle message -->
        <TextView
            android:id="@+id/tvTakeOrderSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Te asignarás como repartidor oficial para llevar este pedido al cliente."
            android:textColor="#A0B3A8"
            android:textSize="13sp" />

        <!-- Order Information Card -->
        <LinearLayout
            android:id="@+id/cardOrderPreviewTake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_logout_user_card"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Code & Total Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTakeOrderCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_order_code_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#FFD54F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="#A4B92C" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTakeOrderTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00E676"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="S/ 38.50" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#1F3D2E" />

            <!-- Client info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_client_user"
                    app:tint="#8AA394" />

                <TextView
                    android:id="@+id/tvTakeOrderCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Carlos Mendoza" />
            </LinearLayout>

            <!-- Address info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_location_pin"
                    app:tint="#FF5252" />

                <TextView
                    android:id="@+id/tvTakeOrderAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#CBE3D6"
                    android:textSize="13sp"
                    tools:text="Av. Los Héroes 452 (Frente al parque)" />
            </LinearLayout>

            <!-- Payment Method & Distance Tag Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTakeOrderPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_admin_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="#40C4FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="💵 Efectivo (Paga exacto)" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvTakeOrderDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#8AA394"
                    android:textSize="12sp"
                    tools:text="📍 ~2.4 km de distancia" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions Row -->
        <LinearLayout
            android:id="@+id/layoutTakeOrderButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelTakeOrder"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1B3326"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Cancelar"
                android:textColor="#A0B3A8"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="#2D4D3A"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmTakeOrder"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.35"
                android:backgroundTint="#00E676"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="¡Tomar Pedido!"
                android:textColor="#0B1A12"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_delivery_scooter"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="#0B1A12" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
