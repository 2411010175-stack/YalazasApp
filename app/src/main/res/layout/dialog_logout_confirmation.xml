<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="24dp"
    app:cardBackgroundColor="#122019"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:strokeColor="#2A4838"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:id="@+id/layoutLogoutContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Animated Logout Icon Frame -->
        <FrameLayout
            android:id="@+id/flLogoutIconContainer"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_logout_icon_circle">

            <ImageView
                android:id="@+id/ivLogoutIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="Icono Salir"
                android:src="@drawable/ic_logout_door"
                app:tint="#FF5252" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvLogoutTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="¿Cerrar Sesión?"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtitle message -->
        <TextView
            android:id="@+id/tvLogoutMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="¿Estás seguro de que deseas salir de tu cuenta de Yalazas Fast Food?"
            android:textColor="#A0B3A8"
            android:textSize="14sp" />

        <!-- User Information Mini Card -->
        <LinearLayout
            android:id="@+id/cardUserInfoLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_logout_user_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <!-- Avatar / Initials container -->
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_user_avatar_circle">

                <TextView
                    android:id="@+id/tvUserAvatarInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="A" />
            </FrameLayout>

            <!-- User Name and Email/Role -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserNameLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Alex Repartidor" />

                <TextView
                    android:id="@+id/tvUserEmailLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#8AA394"
                    android:textSize="12sp"
                    tools:text="repartidor@yalazas.com" />
            </LinearLayout>

            <!-- Role Badge -->
            <TextView
                android:id="@+id/tvUserRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_logout_role_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#69F0AE"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🛵 Repartidor" />
        </LinearLayout>

        <!-- Actions Row -->
        <LinearLayout
            android:id="@+id/layoutLogoutButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelLogout"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1B3326"
                android:text="Cancelar"
                android:textColor="#A0B3A8"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="#2D4D3A"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmLogout"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#D32F2F"
                android:text="Sí, Salir"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_logout_door"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
