<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardComanda"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/cocina_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/yalaza_border"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra superior de estado dinámica -->
        <View
            android:id="@+id/barraComanda"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:background="@color/yalaza_pink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="13dp">

            <!-- Fila superior: Código de pedido y Temporizador -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCodigoComanda"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="PEDIDO #A4B92C" />

                <TextView
                    android:id="@+id/tvTiempoComanda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:maxWidth="112dp"
                    android:maxLines="2"
                    android:textColor="@color/yalaza_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="En preparación\nhace 1 h 08 min" />
            </LinearLayout>

            <!-- Subfila: Canal de servicio (Mesa / Delivery) y Estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvServicioComanda"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_kds_badge"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/cocina_text_secondary"
                    android:textSize="12sp"
                    tools:text="🍽️ Mesa 4 · 12:30" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/tvEstadoComanda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_delivery_address_pill"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/yalaza_orange"
                    android:textSize="12sp"
                    tools:text="👨‍🍳 En preparación" />
            </LinearLayout>

            <!-- Bloque estilo Ticket de Platos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_kds_ticket_items"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:text="DETALLE DE PREPARACIÓN"
                    android:textColor="@color/yalaza_lime_dark"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvProductosComanda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:text="2 × Alitas BBQ\n   Salsa tártara\n1 × Gaseosa Inka Cola" />
            </LinearLayout>

            <!-- Nota del cliente o mesero -->
            <TextView
                android:id="@+id/tvNotaComanda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_admin_note_card"
                android:fontFamily="sans-serif-medium"
                android:padding="12dp"
                android:textColor="@color/yalaza_yellow"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="📝 Nota: Muy crocantes y sin picante" />

            <TextView
                android:id="@+id/tvEsperaComanda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_kds_ticket_items"
                android:gravity="center"
                android:padding="11dp"
                android:textColor="@color/yalaza_lime_dark"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="En espera del mesero · Listo para servir" />

            <!-- Botón de acción ergonómico para cocina -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccionComanda"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:elevation="0dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                app:strokeWidth="1dp"
                tools:text="¡Pedido listo! ✅" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
