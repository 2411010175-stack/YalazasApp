<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="20dp"
    app:cardBackgroundColor="#122019"
    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:strokeColor="#2A4838"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:id="@+id/layoutBatchTakeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Animated Batch Icon Circle -->
        <FrameLayout
            android:id="@+id/flBatchTakeIconContainer"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_batch_take_icon_circle">

            <ImageView
                android:id="@+id/ivBatchTakeIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="Optimizar Lote"
                android:src="@drawable/ic_flash_route"
                app:tint="#FFD54F" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvBatchTakeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="⚡ Optimizar Ruta en Lote"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtitle message -->
        <TextView
            android:id="@+id/tvBatchTakeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Se calculará la mejor secuencia de paradas considerando distancia y tiempo de espera."
            android:textColor="#A0B3A8"
            android:textSize="13sp" />

        <!-- Orders Summary Preview Card -->
        <LinearLayout
            android:id="@+id/cardBatchPreviewTake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_logout_user_card"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Count & Total Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBatchOrdersCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_order_code_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#FFD54F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="📦 3 Pedidos" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvBatchTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00E676"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Total: S/ 115.00" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#1F3D2E" />

            <!-- AI Optimizer badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_admin_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="🧠 Algoritmo de Secuenciación Activo"
                    android:textColor="#69F0AE"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- List Preview Text -->
            <TextView
                android:id="@+id/tvBatchOrdersPreviewList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#CBE3D6"
                android:textSize="13sp"
                tools:text="• #A4B92C - Carlos M. (Av. Los Héroes)\n• #99EF1A - Ana R. (Jr. Lima 123)\n• #C230AB - Miguel P. (Urb. Primavera)" />
        </LinearLayout>

        <!-- Actions Row -->
        <LinearLayout
            android:id="@+id/layoutBatchTakeButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelBatchTake"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1B3326"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="Cancelar"
                android:textColor="#A0B3A8"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="#2D4D3A"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmBatchTake"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.35"
                android:backgroundTint="#FFD54F"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="¡Iniciar Ruta!"
                android:textColor="#261A00"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_flash_route"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="#261A00" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
