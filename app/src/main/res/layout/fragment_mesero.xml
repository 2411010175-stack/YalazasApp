<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yalaza_bg">

    <!-- Panel del salón con navegación fija; el contenido se desplaza por encima. -->
    <LinearLayout
        android:id="@+id/contenedorDashboardMesero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/contenedorSalonMesero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/barraSalonMesero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/yalaza_bg"
            app:elevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll|snap">

    <!-- CABECERA SUPERIOR YALAZAS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="42dp"
            android:contentDescription="Yalazas Restaurante"
            android:src="@drawable/yalaza_logo" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalirMesero"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Salir"
            android:textColor="@color/yalaza_pink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/bg_header_glow" />

    <!-- BARRA SUPERIOR DE TÍTULO Y SALUDO -->
    <TextView
        android:id="@+id/tvTituloSeccionMesero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-black"
        android:text="Salón y Mesas"
        android:textColor="@color/white"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvSaludoMesero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:text="Gestión de comandas y pedidos en el local"
        android:textColor="@color/cocina_text_secondary"
        android:textSize="13sp" />

    <!-- TARJETAS DE ESTADÍSTICAS RÁPIDAS -->
    <LinearLayout
        android:id="@+id/contenedorEstadisticasMesero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/yalaza_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/yalaza_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvMesasMesero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="—"
                    android:textColor="@color/yalaza_yellow"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Mesas activas"
                    android:textColor="@color/yalaza_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/yalaza_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/yalaza_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvListosMesero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="—"
                    android:textColor="@color/yalaza_lime_dark"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Listos para servir"
                    android:textColor="@color/yalaza_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Acción principal del salón. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevaComandaMesero"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:text="Nuevo pedido"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/yalaza_pink"
        app:cornerRadius="15dp"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white" />

            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

    <!-- PANEL 1: LISTADO DE MESAS ACTIVAS DEL SALÓN -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/panelMesasMesero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/contenedorFiltrosMesa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTodasMesero"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Todas"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLibresMesero"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Libres"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOcupadasMesero"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Ocupadas"
                android:textAllCaps="false" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaMesasSalon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_mesa_salon" />

        <TextView
            android:id="@+id/tvVacioFiltroMesas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:paddingVertical="14dp"
            android:textColor="@color/cocina_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEncabezadoPedidosMesero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-bold"
            android:text="Comandas en curso"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <ProgressBar
            android:id="@+id/progresoMesero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvVacioMesero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:gravity="center"
            android:padding="24dp"
            android:text="No hay comandas activas"
            android:textColor="@color/cocina_text_secondary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaPedidosMesa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_pedido_mesa" />
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/cocina_nav_bg"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <LinearLayout android:id="@+id/navMesasMesero" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical"
            android:contentDescription="Mesas">
            <ImageView android:id="@+id/iconoNavMesasMesero" android:layout_width="22dp"
                android:layout_height="22dp" android:src="@drawable/ic_restaurant_table"
                android:contentDescription="@null" />
            <TextView android:id="@+id/textoNavMesasMesero" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="Mesas" android:textSize="11sp" android:textColor="@color/yalaza_pink" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navServirMesero" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical"
            android:contentDescription="Por servir">
            <ImageView android:id="@+id/iconoNavServirMesero" android:layout_width="22dp"
                android:layout_height="22dp" android:src="@drawable/ic_receipt"
                android:contentDescription="@null" />
            <TextView android:id="@+id/textoNavServirMesero" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="Por servir" android:textSize="11sp" android:textColor="@color/cocina_text_secondary" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navHistorialMesero" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical"
            android:contentDescription="Historial de hoy">
            <ImageView android:id="@+id/iconoNavHistorialMesero" android:layout_width="22dp"
                android:layout_height="22dp" android:src="@drawable/ic_delivery_history"
                android:contentDescription="@null" />
            <TextView android:id="@+id/textoNavHistorialMesero" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="Historial" android:textSize="11sp" android:textColor="@color/cocina_text_secondary" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <!-- Nueva pantalla: selección de mesa, carta y confirmación ocupan todo el espacio. -->
    <LinearLayout
        android:id="@+id/panelNuevaComandaMesero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarNuevaComandaMesero"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Volver a mesas"
                android:textAllCaps="false"
                android:textColor="@color/yalaza_yellow"
                app:icon="@drawable/ic_back_arrow"
                app:iconTint="@color/yalaza_yellow" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:fontFamily="sans-serif-bold"
                android:text="Nuevo pedido"
                android:textColor="@color/white"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- ==================== PÁGINA 1: ELEGIR MESAS ==================== -->
        <ScrollView
            android:id="@+id/subpanelPaso1Mesa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Paso 1: Selecciona una Mesa"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvMesaSeleccionadaMensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Selecciona una mesa disponible del local"
                    android:textColor="@color/cocina_text_secondary"
                    android:textSize="13sp" />

                <!-- Selector del salón sincronizado con las mesas configuradas por administración. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listaSelectorMesas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_mesa_salon" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Botón Continuar a la Carta -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIrACartaPaso2"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Continuar a la carta →"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:backgroundTint="@color/yalaza_pink"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ==================== PÁGINA 2: NOMBRE CLIENTE Y CARTA COMPLETA ==================== -->
        <LinearLayout
            android:id="@+id/subpanelPaso2Carta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Fila superior: Nombre de Mesa actual y botón para cambiar de mesa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp">

                <TextView
                    android:id="@+id/tvPaso2MesaActual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_kds_badge"
                    android:fontFamily="sans-serif-black"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:text="Atendiendo Mesa 1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCambiarMesaPaso2"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cambiar mesa"
                    android:textColor="@color/yalaza_yellow" />
            </LinearLayout>

            <!-- PARTE SUPERIOR: NOMBRE DEL CLIENTE (Opcional) -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:hint="Nombre del cliente en la mesa (opcional)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputClienteMesa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLength="80" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- BUSCADOR DE PLATOS -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:hint="Buscar plato, alitas, bebidas...">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputBuscarProductoMesa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- EN LO DEMÁS DE LA PANTALLA: CARTA COMPLETA CON FOTOS Y DESCRIPCIÓN -->
            <TextView
                android:id="@+id/tvSinProductosMesa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="Cargando la carta…"
                android:textColor="@color/cocina_text_secondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaProductosMesa"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                tools:listitem="@layout/item_producto_mesa" />

            <!-- BARRA INFERIOR FLOTANTE DE TOTAL Y CONTINUAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tab_pill_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCantidadPlatosBorrador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="0 platos seleccionados"
                        android:textColor="@color/cocina_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTotalPaso2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="S/ 0.00"
                        android:textColor="@color/yalaza_lime_dark"
                        android:textSize="20sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRevisarComandaPaso2"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Ver pedido →"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/yalaza_pink"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== PÁGINA 3: RESUMEN, INDICACIONES Y ENVÍO A COCINA ==================== -->
        <ScrollView
            android:id="@+id/subpanelPaso3Resumen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="Paso 3: Confirmar pedido"
                        android:textColor="@color/white"
                        android:textSize="20sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVolverACartaPaso3"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="← Agregar más"
                        android:textColor="@color/yalaza_yellow" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPaso3ResumenHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/cocina_text_secondary"
                    android:textSize="13sp"
                    tools:text="Mesa 1 · Cliente: Juan Pérez" />

                <TextView
                    android:id="@+id/tvAvisoMesaOcupada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_kds_ticket_items"
                    android:padding="12dp"
                    android:textColor="@color/yalaza_yellow"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Esta mesa ya tiene una comanda activa. El nuevo pedido se registrará por separado." />

                <!-- Lista de platos agregados en el borrador -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Platos para preparar:"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/contenedorBorradorMesero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvBorradorVacioMesero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:text="Aún no agregaste platos."
                    android:textColor="@color/cocina_text_secondary" />

                <!-- Indicaciones para cocina -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Indicaciones para cocina (ej: sin ají, salsas aparte)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputNotaMesa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="300"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Tarjeta explicativa de Total y Cobro -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/yalaza_surface"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/yalaza_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-bold"
                                android:text="Total a pagar:"
                                android:textColor="@color/white"
                                android:textSize="17sp" />

                            <TextView
                                android:id="@+id/tvTotalMesero"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/yalaza_lime_dark"
                                android:textSize="24sp"
                                tools:text="S/ 0.00" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="ℹ️ Este total se cobrará al finalizar cuando el cliente se retire del local."
                            android:textColor="@color/yalaza_yellow"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Botón de Envío a Cocina -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarComandaMesero"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Enviar comanda a cocina"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:backgroundTint="@color/yalaza_pink"
                    app:cornerRadius="16dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
