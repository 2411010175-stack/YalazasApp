<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Cocina.BotonNavegacion" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cocina_nav_colors</item>
        <item name="backgroundTint">@color/cocina_nav_button_colors</item>
        <item name="cornerRadius">14dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">19dp</item>
        <item name="iconTint">@color/cocina_nav_colors</item>
    </style>

    <style name="Cocina.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/cocina_surface</item>
        <item name="colorPrimary">@color/cocina_nav_active</item>
    </style>
</resources>
