<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#361723" />
            <stroke android:width="2dp" android:color="@color/yalaza_pink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/yalaza_surface" />
            <stroke android:width="1dp" android:color="@color/yalaza_border" />
        </shape>
    </item>
</selector>
