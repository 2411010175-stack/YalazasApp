rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('active', true) == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '') in ['ADMIN', 'ADMINISTRADOR'];
    }

    match /products/{imageName} {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if admin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
